# Copia este archivo a .env y rellena los valores antes de ejecutar docker compose up.

# ── SQL Server ────────────────────────────────────────────────────────────────
# Contraseña del usuario SA: mínimo 8 caracteres, mayúscula + minúscula + número + especial.
SA_PASSWORD=DataFlow@Secure123!

# ── JWT ───────────────────────────────────────────────────────────────────────
# Clave secreta para firmar los tokens JWT (mínimo 32 caracteres).
JWT_SECRET=DataFlowPlatform-ChangeThisSecretInProduction-MinLength32Chars!

# ── Google BigQuery ───────────────────────────────────────────────────────────
# ID del proyecto GCP que contiene el dataset de BigQuery.
BIGQUERY_PROJECT_ID=tu-proyecto-gcp

# Nombre del dataset dentro del proyecto.
BIGQUERY_DATASET_ID=dataflow_platform

# Tabla principal de datos de pipeline.
BIGQUERY_TABLE_ID=pipeline_data

# Coloca el archivo JSON de credenciales de la cuenta de servicio en:
#   ./credentials/bigquery-key.json
# El volumen lo monta en /app/credentials/ dentro de los contenedores backend y python.
